{
  "name": "@qbr/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "evaluate": "tsx src/scripts/evaluate.ts"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.65",
    "@qbr/contracts": "0.1.0",
    "ai": "^7.0.141",
    "bullmq": "^5.61.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "vitest": "^4.0.0"
  }
}
