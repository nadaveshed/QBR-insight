# Copy to .env and add your DeepSeek API key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DATABASE_URL=postgres://qbr:qbr_local@127.0.0.1:55432/qbr
REDIS_URL=redis://127.0.0.1:56379
PORT=3001
HOST=127.0.0.1
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=10
MAX_DOCUMENT_PAGES=50
MAX_DOCUMENT_CHARS=80000
WORKER_CONCURRENCY=2
QUEUE_RATE_MAX=10
QUEUE_RATE_DURATION_MS=60000
LLM_TIMEOUT_MS=120000
LOG_LEVEL=info
